{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eidos-plugin-marketplace",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "community.eidos.space",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
